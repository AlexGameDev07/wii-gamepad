# Maintainer: AlexDev07 <alekeymurcia at gmail dot com>
pkgname=wii-gamepad
pkgver=1.1
pkgrel=1
pkgdesc="Wii Remote + Nunchuk as an Xbox 360 controller (rumble, gyro, per-game profiles, mouse mode)"
arch=('any')
url="https://github.com/AlexGameDev07/wii-gamepad"
license=('GPL-3.0-or-later')
depends=('python' 'python-evdev' 'python-gobject' 'gtk4' 'libadwaita' 'tk' 'bluez' 'bluez-utils'
         'hicolor-icon-theme')
optdepends=('at-spi2-core: on-screen keyboard opens by itself in text fields'
            'libxkbcommon: on-screen keyboard types with your keyboard layout'
            'libnotify: desktop notifications (notify-send)'
            'pipewire: sounds (pw-play)'
            'libpulse: sounds (paplay)')
install=wii-gamepad.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('bef425d9dc484a327f952df22053de962c9ff6f4c8d2fbf1656211a94b83f565')

package() {
    cd "$pkgname-$pkgver"
    local data=/usr/share/$pkgname

    install -Dm644 -t "$pkgdir$data" wii_gamepad.py wii_gamepad_config.py wii_gamepad_adw.py wii_gamepad_gui.py \
        wii_keyboard.py wii-gamepad.svg
    install -Dm644 -t "$pkgdir$data/sonidos" sonidos/*
    install -Dm644 wii-gamepad.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/wii-gamepad.svg"
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE sonidos/LICENSE-Kenney.txt
    install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md README.en.md

    install -d "$pkgdir/usr/bin"
    printf '#!/bin/sh\nexec /usr/bin/python3 %s/wii_gamepad.py "$@"\n' "$data" > "$pkgdir/usr/bin/wii-gamepad"
    printf '#!/bin/sh\nexec /usr/bin/python3 %s/wii_gamepad_config.py "$@"\n' "$data" > "$pkgdir/usr/bin/wii-gamepad-config"
    chmod 755 "$pkgdir/usr/bin/wii-gamepad" "$pkgdir/usr/bin/wii-gamepad-config"

    # Lo mismo que hace ./install.sh --service, pero para todo el sistema
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/65-wii-gamepad.rules" <<'EOF'
# wii-gamepad: acceso del usuario al Wiimote y a /dev/uinput
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", TAG+="uaccess", OPTIONS+="static_node=uinput"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Nintendo Wii Remote*", MODE="0660", GROUP="input", TAG+="uaccess"
# El LED del Wiimote muestra el número de jugador
SUBSYSTEM=="leds", KERNEL=="*:blue:p[0-3]", DRIVERS=="wiimote", RUN+="/bin/chmod 0666 /sys%p/brightness"
# Oculta el Wiimote original (y su Nunchuk) a los juegos: solo ven el mando virtual
SUBSYSTEM=="input", ATTRS{name}=="Nintendo Wii Remote*", ENV{ID_INPUT_JOYSTICK}=""
SUBSYSTEM=="input", KERNEL=="js*", ATTRS{name}=="Nintendo Wii Remote*", MODE="0600"
# Arranca el puente (servicio de usuario) cuando se conecta el Wiimote
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Nintendo Wii Remote", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="wii-gamepad.service"
EOF
    printf 'hid-wiimote\nuinput\n' | install -Dm644 /dev/stdin "$pkgdir/usr/lib/modules-load.d/wii-gamepad.conf"

    install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/wii-gamepad.service" <<'EOF'
[Unit]
Description=Wiimote + Nunchuk como mando Xbox 360

[Service]
ExecStart=/usr/bin/wii-gamepad --once
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
EOF

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/io.github.alexgamedev07.WiiGamepad.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Wii Gamepad
GenericName=Configuración del mando
Comment=Configura el Wiimote y el Nunchuk como mando de Xbox
Keywords=wii;wiimote;nunchuk;mando;control;controles;gamepad;joystick;botones;nintendo;
Exec=wii-gamepad-config
Icon=wii-gamepad
StartupWMClass=Wii-gamepad
Terminal=false
Categories=Game;
EOF
}
